{
    "name": "controleonline/api-community",
    "description": "ControleOnline community API",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-ctype": "*",
        "ext-fileinfo": "*",
        "ext-iconv": "*",
        "api-platform/core": "^4.0",
        "beberlei/doctrineextensions": "^1.5",
        "composer/installers": "^2.2",
        "controleonline/accounting": "1.0.0",
        "controleonline/common": "1.0.1",
        "controleonline/contract": "1.0.0",
        "controleonline/report": "1.0.0",
        "controleonline/ead": "1.0.0",
        "controleonline/financial": "1.0.1",
        "controleonline/integration": "1.0.0",
        "controleonline/logistic": "1.0.0",
        "controleonline/messages-sdk": "1.0.0",
        "controleonline/multi-tenancy": "1.0.0",
        "controleonline/orders": "1.0.0",
        "controleonline/people": "1.0.0",
        "controleonline/products": "1.0.0",
        "controleonline/queue": "1.0.0",
        "controleonline/smoke-tests-playground": "1.0.0",
        "controleonline/spc-sdk": "1.0.0",
        "controleonline/tasks": "1.0.0",
        "controleonline/users": "1.0.0",
        "controleonline/websocket-server": "1.0.0",
        "controleonline/whatsapp-sdk": "1.0.0",
        "ctodobom/api-inter": "dev-master",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^3.7",
        "doctrine/orm": "^3.2",
        "dompdf/dompdf": "^3.0",
        "dragonmantank/cron-expression": "^3.4",
        "endroid/qr-code": "^6.0",
        "fpdf/fpdf": "^1.86",
        "google/auth": "^1.45",
        "guzzlehttp/guzzle": "^7.9",
        "league/html-to-markdown": "^5.1",
        "league/oauth2-facebook": "^2.2",
        "league/oauth2-google": "^4.0",
        "league/oauth2-instagram": "^3.1",
        "mautic/api-library": "^3.0",
        "nelmio/cors-bundle": "^2.5",
        "nfephp-org/sped-cte": "dev-master",
        "nfephp-org/sped-da": "dev-master",
        "nfephp-org/sped-nfe": "dev-master",
        "nfephp-org/sped-pos": "dev-master",
        "phpdocumentor/reflection-docblock": "^5.4",
        "phpoffice/phpspreadsheet": "^5.0",
        "symfony/asset": "^8.1",
        "symfony/console": "^8.1",
        "symfony/doctrine-messenger": "^8.1",
        "symfony/dotenv": "^8.1",
        "symfony/expression-language": "^8.1",
        "symfony/flex": "^2.4",
        "symfony/framework-bundle": "^8.1",
        "symfony/google-mailer": "^8.1",
        "symfony/http-client": "^8.1",
        "symfony/lock": "^8.1",
        "symfony/mailer": "^8.1",
        "symfony/messenger": "^8.1",
        "symfony/monolog-bundle": "^4.0",
        "symfony/property-access": "^8.1",
        "symfony/property-info": "^8.1",
        "symfony/runtime": "^8.1",
        "symfony/scheduler": "^8.1",
        "symfony/security-bundle": "^8.1",
        "symfony/security-core": "^8.1",
        "symfony/security-http": "^8.1",
        "symfony/serializer": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "symfony/validator": "^8.1",
        "symfony/var-dumper": "^8.1",
        "symfony/yaml": "^8.1",
        "tecnickcom/tcpdf": "^6.7",
        "vich/uploader-bundle": "^2.3",
        "webonyx/graphql-php": "^15.12"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.1",
        "rector/rector": "^2.0",
        "symfony/browser-kit": "^8.1",
        "symfony/css-selector": "^8.1",
        "symfony/maker-bundle": "^1.60",
        "symfony/phpunit-bridge": "^8.1",
        "symfony/stopwatch": "^8.1",
        "symfony/web-profiler-bundle": "^8.1"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "optimize-autoloader": true,
        "sort-packages": true,
        "component-dir": "public/vendor",
        "allow-plugins": {
            "symfony/flex": true,
            "php-http/discovery": true,
            "symfony/runtime": true,
            "composer/installers": true
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "pre-install-cmd": [
            "echo '{\"directory\" : \"public/vendor/\"}' > .bowerrc"
        ],
        "post-install-cmd": [
            "App\\FixAutoload::postInstall",
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "App\\FixAutoload::postInstall",
            "@auto-scripts"
        ]
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "^8.1",
            "docker": false
        }
    }
}
